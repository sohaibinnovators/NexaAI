# Copy this file to `.env.local` and fill in real values locally.
# For Vercel, set the same keys in Project Settings → Environment Variables.
#
# Security:
# - Never commit real keys.
# - Never use a NEXT_PUBLIC_ prefix for the API key.
# - The key must remain server-side only.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
